# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bbq_shop
DB_USER=root
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
JWT_ADMIN_SECRET=your_admin_jwt_secret_key
JWT_ADMIN_EXPIRES_IN=24h

# WeChat Mini Program
WX_APP_ID=your_wx_app_id
WX_APP_SECRET=your_wx_app_secret

# WeChat Pay
WX_MCH_ID=your_mch_id
WX_MCH_KEY=your_mch_key
WX_NOTIFY_URL=https://yourdomain.com/api/v1/pay/notify

# 支付模拟模式开关
# true  = 模拟支付（开发/测试环境，无需真实商户号）
# false = 真实微信支付（生产环境）
# 注意：非 production 环境默认自动开启模拟模式
# 可在管理后台「系统设置 > 支付设置」运行时切换，无需重启
WECHAT_PAY_MOCK=true

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
