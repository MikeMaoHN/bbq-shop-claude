/* === CSS Variables === */
page {
  --theme-color: #FF6B35;
  --theme-light: #FFF3ED;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-placeholder: #999999;
  --text-white: #ffffff;
  --bg-color: #f5f5f5;
  --bg-white: #ffffff;
  --border-color: #eeeeee;
  --price-color: #FF4D4F;
  --success-color: #52C41A;
  --warning-color: #FAAD14;

  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

/* === Flex Utilities === */
.flex {
  display: flex;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.flex-shrink-0 {
  flex-shrink: 0;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.items-end {
  align-items: flex-end;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-around {
  justify-content: space-around;
}

.justify-end {
  justify-content: flex-end;
}

/* === Text Utilities === */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-placeholder {
  color: var(--text-placeholder);
}

.text-theme {
  color: var(--theme-color);
}

.text-white {
  color: var(--text-white);
}

.text-bold {
  font-weight: bold;
}

.text-sm {
  font-size: 24rpx;
}

.text-md {
  font-size: 28rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* === Spacing === */
.p-0 { padding: 0; }
.p-sm { padding: 12rpx; }
.p-md { padding: 20rpx; }
.p-lg { padding: 30rpx; }

.pt-sm { padding-top: 12rpx; }
.pt-md { padding-top: 20rpx; }
.pt-lg { padding-top: 30rpx; }

.pb-sm { padding-bottom: 12rpx; }
.pb-md { padding-bottom: 20rpx; }
.pb-lg { padding-bottom: 30rpx; }

.pl-sm { padding-left: 12rpx; }
.pl-md { padding-left: 20rpx; }
.pl-lg { padding-left: 30rpx; }

.pr-sm { padding-right: 12rpx; }
.pr-md { padding-right: 20rpx; }
.pr-lg { padding-right: 30rpx; }

.px-sm { padding-left: 12rpx; padding-right: 12rpx; }
.px-md { padding-left: 20rpx; padding-right: 20rpx; }
.px-lg { padding-left: 30rpx; padding-right: 30rpx; }

.py-sm { padding-top: 12rpx; padding-bottom: 12rpx; }
.py-md { padding-top: 20rpx; padding-bottom: 20rpx; }
.py-lg { padding-top: 30rpx; padding-bottom: 30rpx; }

.m-0 { margin: 0; }
.m-sm { margin: 12rpx; }
.m-md { margin: 20rpx; }
.m-lg { margin: 30rpx; }

.mt-sm { margin-top: 12rpx; }
.mt-md { margin-top: 20rpx; }
.mt-lg { margin-top: 30rpx; }

.mb-sm { margin-bottom: 12rpx; }
.mb-md { margin-bottom: 20rpx; }
.mb-lg { margin-bottom: 30rpx; }

.ml-sm { margin-left: 12rpx; }
.ml-md { margin-left: 20rpx; }
.ml-lg { margin-left: 30rpx; }

.mr-sm { margin-right: 12rpx; }
.mr-md { margin-right: 20rpx; }
.mr-lg { margin-right: 30rpx; }

/* === Card === */
.card {
  background-color: var(--bg-white);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* === Price === */
.price {
  color: var(--price-color);
  font-weight: bold;
}

.price-symbol {
  font-size: 24rpx;
  color: var(--price-color);
  font-weight: bold;
}

.price-integer {
  font-size: 36rpx;
  color: var(--price-color);
  font-weight: bold;
}

.price-original {
  color: var(--text-placeholder);
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 8rpx;
}

/* === Button === */
.btn-primary {
  background-color: var(--theme-color);
  color: var(--text-white);
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.5;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background-color: transparent;
  color: var(--theme-color);
  border: 2rpx solid var(--theme-color);
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.5;
}

.btn-outline::after {
  border: none;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* === Divider === */
.divider {
  height: 1rpx;
  background-color: var(--border-color);
  margin: 20rpx 0;
}

/* === Safe Area === */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* === Loading === */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  color: var(--text-placeholder);
  font-size: 26rpx;
  margin-top: 20rpx;
}

/* === Empty State === */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  color: var(--text-placeholder);
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

/* === Badge === */
.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background-color: var(--price-color);
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* === Tag === */
.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 6rpx;
}

.tag-primary {
  background-color: var(--theme-light);
  color: var(--theme-color);
}

.tag-success {
  background-color: #f0fff0;
  color: var(--success-color);
}
