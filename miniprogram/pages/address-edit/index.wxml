<view class="edit-page">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" type="number" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
    </view>
    <view class="form-item" bindtap="onPickRegion">
      <text class="form-label">所在地区</text>
      <text class="form-value {{form.province ? '' : 'placeholder'}}">{{form.province ? form.province + form.city + form.district : '请选择省/市/区'}}</text>
    </view>
    <view class="form-item">
      <text class="form-label">详细地址</text>
      <input class="form-input" placeholder="街道、楼栋等" value="{{form.detail}}" bindinput="onInput" data-field="detail" />
    </view>
  </view>

  <view class="default-section">
    <text class="form-label">设为默认地址</text>
    <switch checked="{{form.is_default}}" bindchange="onDefaultChange" color="#FF6B35" />
  </view>

  <view class="save-btn" bindtap="onSave">保存</view>
  <view class="delete-btn" bindtap="onDelete" wx:if="{{isEdit}}">删除地址</view>
</view>
