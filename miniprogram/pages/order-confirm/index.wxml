<view class="confirm-page">
  <!-- 收货地址 -->
  <view class="address-card" bindtap="onSelectAddress">
    <view class="address-content" wx:if="{{address}}">
      <view class="address-top">
        <text class="addr-name">{{address.name}}</text>
        <text class="addr-phone">{{address.phone}}</text>
        <text class="default-tag" wx:if="{{address.is_default}}">默认</text>
      </view>
      <text class="addr-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text>
    </view>
    <view class="no-address" wx:else>
      <text class="add-icon">+</text>
      <text>添加收货地址</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 商品列表 -->
  <view class="items-card">
    <view class="shop-name">烤乐汇</view>
    <view class="order-item" wx:for="{{orderItems}}" wx:key="index">
      <image class="item-img" src="{{item.image || '/images/default.png'}}" mode="aspectFill" />
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-spec" wx:if="{{item.spec_name}}">{{item.spec_name}}</text>
        <view class="item-row">
          <text class="item-price">¥{{item.price}}</text>
          <text class="item-qty">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 配送时间 -->
  <view class="option-card">
    <view class="option-row">
      <text class="option-label">配送时间</text>
      <picker mode="selector" range="{{timeSlots}}" bindchange="onTimeChange">
        <text class="option-value">{{selectedTime || '请选择'}}</text>
      </picker>
    </view>
  </view>

  <!-- 备注 -->
  <view class="remark-card">
    <text class="remark-label">订单备注</text>
    <input class="remark-input" placeholder="选填，备注口味、时间等要求" bindinput="onRemarkInput" />
  </view>

  <!-- 价格明细 -->
  <view class="price-card">
    <view class="price-row">
      <text>商品合计</text>
      <text>¥{{totalAmount}}</text>
    </view>
    <view class="price-row">
      <text>配送费</text>
      <text>¥{{deliveryFee}}</text>
    </view>
    <view class="price-row total-row">
      <text>实付金额</text>
      <text class="pay-amount">¥{{payAmount}}</text>
    </view>
  </view>

  <!-- 底部提交 -->
  <view class="submit-bar">
    <view class="submit-price">
      <text>合计：</text>
      <text class="pay-price">¥{{payAmount}}</text>
    </view>
    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中...' : '提交订单'}}
    </view>
  </view>
</view>
