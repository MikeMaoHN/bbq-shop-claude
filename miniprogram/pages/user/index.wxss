.user-page { min-height: 100vh; background: #f5f5f5; }
.user-header { background: #FF6B35; padding: 60rpx 30rpx 40rpx; display: flex; align-items: center; }
.user-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.5); }
.user-detail { margin-left: 24rpx; }
.user-name { font-size: 36rpx; color: #fff; font-weight: bold; display: block; }
.user-phone { font-size: 24rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; display: block; }
.login-prompt { display: flex; align-items: center; gap: 20rpx; }
.login-text { font-size: 32rpx; color: #fff; font-weight: bold; }
.order-section { background: #fff; margin: 20rpx 0 0; padding: 30rpx; }
.order-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }
.order-title { font-size: 30rpx; font-weight: bold; color: #333; }
.order-all { font-size: 24rpx; color: #999; }
.order-icons { display: flex; justify-content: space-around; }
.order-icon-item { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.order-icon { font-size: 56rpx; }
.order-label { font-size: 22rpx; color: #666; }
.menu-section { background: #fff; margin-top: 20rpx; }
.menu-item { display: flex; align-items: center; padding: 32rpx 30rpx; border-bottom: 1rpx solid #f5f5f5; }
.menu-icon { font-size: 40rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 28rpx; color: #333; }
.menu-arrow { font-size: 28rpx; color: #ccc; }
