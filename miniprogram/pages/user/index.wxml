<view class="user-page">
  <!-- 用户信息头部 -->
  <view class="user-header">
    <view class="user-info" wx:if="{{userInfo.id}}">
      <image class="user-avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="user-detail">
        <text class="user-name">{{userInfo.nickname || '微信用户'}}</text>
        <text class="user-phone">{{userInfo.phone || '未绑定手机'}}</text>
      </view>
    </view>
    <view class="login-prompt" wx:else bindtap="onLogin">
      <image class="user-avatar" src="/images/default-avatar.png" mode="aspectFill" />
      <text class="login-text">点击登录</text>
    </view>
  </view>

  <!-- 订单入口 -->
  <view class="order-section">
    <view class="order-header">
      <text class="order-title">我的订单</text>
      <navigator url="/pages/order-list/index?status=-1" class="order-all">全部订单 ›</navigator>
    </view>
    <view class="order-icons">
      <navigator url="/pages/order-list/index?status=0" class="order-icon-item">
        <text class="order-icon">💳</text>
        <text class="order-label">待付款</text>
      </navigator>
      <navigator url="/pages/order-list/index?status=1" class="order-icon-item">
        <text class="order-icon">📦</text>
        <text class="order-label">待发货</text>
      </navigator>
      <navigator url="/pages/order-list/index?status=2" class="order-icon-item">
        <text class="order-icon">🚚</text>
        <text class="order-label">待收货</text>
      </navigator>
      <navigator url="/pages/order-list/index?status=3" class="order-icon-item">
        <text class="order-icon">✅</text>
        <text class="order-label">已完成</text>
      </navigator>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <navigator url="/pages/address-list/index" class="menu-item">
      <text class="menu-icon">📍</text>
      <text class="menu-text">收货地址</text>
      <text class="menu-arrow">›</text>
    </navigator>
    <navigator url="/pages/coupon/index" class="menu-item">
      <text class="menu-icon">🎫</text>
      <text class="menu-text">我的优惠券</text>
      <text class="menu-arrow">›</text>
    </navigator>
    <view class="menu-item" bindtap="onContact">
      <text class="menu-icon">📞</text>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
