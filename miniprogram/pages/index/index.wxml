<!-- 搜索栏 -->
<view class="search-bar" bindtap="onSearchTap">
  <view class="search-inner">
    <text class="search-icon">🔍</text>
    <text class="search-placeholder">搜索烧烤美食</text>
  </view>
</view>

<!-- 轮播图 -->
<swiper class="banner-swiper" indicator-dots autoplay circular interval="{{3000}}" duration="{{500}}">
  <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-link="{{item.link}}" data-type="{{item.type}}">
    <image class="banner-image" src="{{item.imageUrl}}" mode="aspectFill" />
  </swiper-item>
</swiper>

<!-- 分类入口 -->
<scroll-view class="category-scroll" scroll-x enable-flex>
  <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="onCategoryTap" data-id="{{item.id}}">
    <image class="category-icon" src="{{item.icon}}" mode="aspectFill" />
    <text class="category-name">{{item.name}}</text>
  </view>
</scroll-view>

<!-- 热门推荐 -->
<view class="section">
  <view class="section-header">
    <text class="section-title">热门推荐</text>
    <text class="section-more">🔥</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 商品列表 -->
  <view class="product-grid" wx:if="{{!loading && hotProducts.length > 0}}">
    <view class="product-card" wx:for="{{hotProducts}}" wx:key="id" bindtap="onProductTap" data-id="{{item.id}}">
      <image class="product-image" src="{{item.imageUrl}}" mode="aspectFill" />
      <view class="product-info">
        <text class="product-name text-ellipsis-2">{{item.name}}</text>
        <view class="product-price-row">
          <view class="price-wrap">
            <text class="price-symbol">¥</text>
            <text class="price-integer">{{item.price}}</text>
            <text class="price-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
          </view>
          <view class="add-cart-btn" catchtap="onAddCart" data-id="{{item.id}}">+</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-container" wx:if="{{!loading && hotProducts.length === 0}}">
    <text class="empty-text">暂无推荐商品</text>
  </view>
</view>
