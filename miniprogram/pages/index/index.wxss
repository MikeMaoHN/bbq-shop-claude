/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background: linear-gradient(to bottom, #FF6B35, #FF8C5A);
}

.search-inner {
  display: flex;
  align-items: center;
  height: 68rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 34rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  color: #999;
  font-size: 26rpx;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 320rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 分类滚动 */
.category-scroll {
  white-space: nowrap;
  background-color: #fff;
  padding: 30rpx 12rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  margin: 0 8rpx;
}

.category-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  background-color: #FFF3ED;
}

.category-name {
  font-size: 24rpx;
  color: #333;
}

/* 区块 */
.section {
  margin-top: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 28rpx;
}

/* 商品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.product-card {
  width: calc(50% - 16rpx);
  margin: 0 8rpx 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.product-image {
  width: 100%;
  height: 340rpx;
}

.product-info {
  padding: 16rpx 20rpx 20rpx;
}

.product-name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  height: 72rpx;
}

.product-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.price-wrap {
  display: flex;
  align-items: baseline;
}

.add-cart-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background-color: #FF6B35;
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
}
