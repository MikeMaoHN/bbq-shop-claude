<view class="address-page">
  <view class="address-card" wx:for="{{addresses}}" wx:key="id">
    <view class="addr-content" bindtap="onSelect" data-item="{{item}}">
      <view class="addr-top">
        <text class="addr-name">{{item.name}}</text>
        <text class="addr-phone">{{item.phone}}</text>
        <text class="default-tag" wx:if="{{item.is_default}}">默认</text>
      </view>
      <text class="addr-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
    </view>
    <view class="addr-actions">
      <view class="edit-btn" bindtap="onEdit" data-id="{{item.id}}">编辑</view>
      <view class="delete-btn" bindtap="onDelete" data-id="{{item.id}}">删除</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && addresses.length === 0}}">
    <text class="empty-text">暂无地址，请添加</text>
  </view>

  <view class="add-btn" bindtap="onAdd">+ 新增收货地址</view>
</view>
