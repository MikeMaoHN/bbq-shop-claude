.search-page { background: #f5f5f5; min-height: 100vh; }
.search-bar { background: #fff; padding: 20rpx 24rpx; display: flex; gap: 16rpx; }
.search-input { flex: 1; background: #f5f5f5; border-radius: 50rpx; padding: 16rpx 30rpx; font-size: 26rpx; }
.search-btn { background: #FF6B35; color: #fff; padding: 16rpx 32rpx; border-radius: 50rpx; font-size: 26rpx; flex-shrink: 0; }
.history-section { background: #fff; margin-top: 16rpx; padding: 24rpx; }
.history-header { display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.history-title { font-size: 28rpx; font-weight: bold; color: #333; }
.clear-btn { font-size: 24rpx; color: #999; }
.history-tags { display: flex; flex-wrap: wrap; gap: 16rpx; }
.history-tag { background: #f5f5f5; padding: 12rpx 24rpx; border-radius: 50rpx; font-size: 24rpx; color: #666; }
.result-section { padding: 16rpx; }
.result-count { font-size: 24rpx; color: #999; margin-bottom: 16rpx; }
.product-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.product-card { width: calc(50% - 8rpx); background: #fff; border-radius: 12rpx; overflow: hidden; }
.product-img { width: 100%; height: 320rpx; }
.product-info { padding: 16rpx; }
.product-name { font-size: 26rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
.product-price { font-size: 28rpx; color: #FF6B35; font-weight: bold; margin-top: 8rpx; display: block; }
.empty-result { text-align: center; padding: 80rpx 0; font-size: 28rpx; color: #999; }
