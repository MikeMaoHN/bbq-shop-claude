<view class="search-page">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索烧烤食材"
      value="{{keyword}}"
      bindinput="onInput"
      bindconfirm="onSearch"
      focus="{{true}}"
      confirm-type="search"
    />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 搜索历史 -->
  <view class="history-section" wx:if="{{!hasResult && history.length > 0}}">
    <view class="history-header">
      <text class="history-title">搜索历史</text>
      <view class="clear-btn" bindtap="onClearHistory">清除</view>
    </view>
    <view class="history-tags">
      <view class="history-tag" wx:for="{{history}}" wx:key="index" bindtap="onHistoryTap" data-word="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="result-section" wx:if="{{hasResult}}">
    <view class="result-count">找到 {{total}} 个商品</view>
    <view class="product-grid">
      <view class="product-card" wx:for="{{results}}" wx:key="id" bindtap="onProductTap" data-id="{{item.id}}">
        <image class="product-img" src="{{item.images[0] || '/images/default.png'}}" mode="aspectFill" />
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-price">¥{{item.price}}</text>
        </view>
      </view>
    </view>
    <view class="empty-result" wx:if="{{results.length === 0}}">
      <text>未找到相关商品</text>
    </view>
  </view>
</view>
