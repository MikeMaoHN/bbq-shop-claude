<view class="order-list-page">
  <!-- 状态tabs -->
  <scroll-view class="tabs" scroll-x>
    <view
      class="tab-item {{activeTab === item.value ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="value"
      bindtap="onTabChange"
      data-value="{{item.value}}"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 订单列表 -->
  <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="onOrderTap" data-id="{{item.id}}">
    <view class="order-header">
      <text class="order-no">订单号：{{item.order_no}}</text>
      <text class="order-status {{statusClass[item.status]}}">{{statusText[item.status]}}</text>
    </view>
    <view class="order-items">
      <view class="item-row" wx:for="{{item.items}}" wx:key="id" wx:for-item="oi">
        <text class="item-name">{{oi.product_name}}</text>
        <text class="item-qty">x{{oi.quantity}}</text>
        <text class="item-price">¥{{oi.price}}</text>
      </view>
    </view>
    <view class="order-footer">
      <text class="order-total">共{{item.items.length}}件 实付：<text class="total-price">¥{{item.pay_amount}}</text></text>
      <view class="action-btns">
        <view class="action-btn cancel-btn" catchtap="onCancel" data-id="{{item.id}}" wx:if="{{item.status === 0}}">取消</view>
        <view class="action-btn primary-btn" catchtap="onReceive" data-id="{{item.id}}" wx:if="{{item.status === 2}}">确认收货</view>
        <view class="action-btn" catchtap="onRefund" data-id="{{item.id}}" wx:if="{{item.status === 1 || item.status === 2}}">申请退款</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && orders.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
  </view>

  <view class="loading-text" wx:if="{{loading}}">加载中...</view>
  <view class="no-more" wx:if="{{!loading && !hasMore && orders.length > 0}}">没有更多了</view>
</view>
