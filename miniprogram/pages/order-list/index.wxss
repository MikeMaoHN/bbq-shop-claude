.order-list-page { background: #f5f5f5; min-height: 100vh; }
.tabs { background: #fff; display: flex; white-space: nowrap; padding: 0 10rpx; }
.tab-item { display: inline-block; padding: 24rpx 30rpx; font-size: 26rpx; color: #666; }
.tab-item.active { color: #FF6B35; border-bottom: 4rpx solid #FF6B35; }
.order-card { background: #fff; margin: 16rpx; border-radius: 16rpx; overflow: hidden; }
.order-header { display: flex; justify-content: space-between; padding: 24rpx 24rpx 16rpx; border-bottom: 1rpx solid #f5f5f5; }
.order-no { font-size: 24rpx; color: #999; }
.order-status { font-size: 26rpx; font-weight: bold; }
.orange { color: #FF6B35; } .blue { color: #1890ff; } .green { color: #52c41a; } .gray { color: #999; }
.order-items { padding: 16rpx 24rpx; }
.item-row { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 0; }
.item-name { flex: 1; font-size: 26rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-qty { font-size: 22rpx; color: #999; margin: 0 20rpx; }
.item-price { font-size: 24rpx; color: #666; }
.order-footer { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 24rpx; border-top: 1rpx solid #f5f5f5; }
.order-total { font-size: 24rpx; color: #666; }
.total-price { color: #FF6B35; font-weight: bold; font-size: 28rpx; }
.action-btns { display: flex; gap: 16rpx; }
.action-btn { font-size: 24rpx; padding: 12rpx 24rpx; border: 1rpx solid #e5e5e5; border-radius: 50rpx; color: #666; }
.primary-btn { border-color: #FF6B35; color: #FF6B35; }
.cancel-btn { color: #999; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 100rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-top: 20rpx; }
.loading-text, .no-more { text-align: center; font-size: 24rpx; color: #999; padding: 20rpx; }
