<view class="category-page">
  <!-- 左侧分类栏 -->
  <scroll-view class="sidebar" scroll-y>
    <view
      class="sidebar-item {{currentCategoryId === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      bindtap="onCategoryTap"
      data-id="{{item.id}}"
    >
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 右侧商品区域 -->
  <scroll-view class="content" scroll-y>
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{productLoading}}">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 商品列表 -->
    <view class="product-list" wx:if="{{!productLoading && products.length > 0}}">
      <view class="product-item" wx:for="{{products}}" wx:key="id" bindtap="onProductTap" data-id="{{item.id}}">
        <image class="product-image" src="{{item.imageUrl}}" mode="aspectFill" />
        <view class="product-info">
          <text class="product-name text-ellipsis-2">{{item.name}}</text>
          <text class="product-desc text-ellipsis" wx:if="{{item.description}}">{{item.description}}</text>
          <view class="product-bottom">
            <view class="price-wrap">
              <text class="price-symbol">¥</text>
              <text class="price-integer">{{item.price}}</text>
              <text class="price-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
            </view>
            <view class="add-cart-btn" catchtap="onAddCart" data-id="{{item.id}}">+</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-container" wx:if="{{!productLoading && products.length === 0}}">
      <text class="empty-text">该分类暂无商品</text>
    </view>
  </scroll-view>
</view>
